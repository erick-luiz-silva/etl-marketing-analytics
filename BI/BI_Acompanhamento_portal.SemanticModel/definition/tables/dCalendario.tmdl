	column 'Nome do Dia'
		lineageTag: b7ebac0b-f92f-4b2d-a6ca-689739802ff1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nome do Dia]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2023, 1, 1), DATE(2026, 12, 31)),
				    "Ano", YEAR([Date]),
				    "Número do Mês", MONTH([Date]),
				    "Mês", FORMAT([Date], "mmm", "pt-BR"),
				    "Mês e Ano", FORMAT([Date], "mmm/yyyy", "pt-BR"),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "Dia da Semana", WEEKDAY([Date]),
				    "Nome do Dia", FORMAT([Date], "dddd", "pt-BR")
				)

	annotation PBI_Id = 1e89fdeeedaa46eca8ff8cdb5bc38ffb

