# Copie para .env e preencha.

# --- GA4 Data API (Service Account) ---
# A Service Account precisa ter papel "Leitor" na propriedade GA4
# (GA4 Admin > Gerenciamento de acesso à propriedade).
GA4_PROPERTY_ID=353835454
GA4_CREDENTIALS_PATH=config/credentials.json

# --- PostgreSQL local ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abcs_marketing_analytics
DB_USER=postgres
DB_PASSWORD=
